# ce qui fait retomber les erreurs `prettier/prettier` ("Delete `CR`")
# ramenées à 0 : ~243 sur enums/index.ts, ~457 sur auth/auth.service.ts.
# On fige LF pour que les corrections tiennent.
api/src/common/enums/index.ts text eol=lf
api/src/modules/auth/auth.service.ts text eol=lf
.gitattributes text eol=lf
