# Encodage des sources normalisé en LF.
#
# `core.autocrlf=true` convertirait ce fichier en CRLF au prochain checkout,
# ce qui fait retomber ~243 erreurs `prettier/prettier` ("Delete `␍`").
# On fige LF pour que la correction tienne.
api/src/common/enums/index.ts text eol=lf
.gitattributes text eol=lf
